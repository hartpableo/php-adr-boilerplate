{
  "name": "hartpableo/php-adr",
  "description": "PHP base framework following the Action-Domain-Responder architecture",
  "type": "project",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Hart Pableo",
      "email": "pableoh@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require": {
    "vlucas/phpdotenv": "^5.6",
    "nikic/fast-route": "^1.3",
    "twig/twig": "^3.24",
    "ext-pdo": "*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "process-timeout": 0,
    "sort-packages": true
  },
  "scripts": {
    "post-create-project-cmd": [
      "php -r \"copy('.env.example', '.env.local');\"",
      "php -r \"if (!file_exists('var/cache')) mkdir('var/cache', 0777, true);\"",
      "php -r \"if (!file_exists('var/cache/twig')) mkdir('var/cache/twig', 0777, true);\""
    ]
  }
}
